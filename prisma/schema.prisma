// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (CLI) and lib/prisma.ts (runtime), not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Coarse ingredient family — drives the category picto (lib/ingredients.ts) and the
// ingredients-page filter. Enum values in English (code); French labels live in i18n.
enum IngredientCategory {
  MEAT
  FISH
  VEGETABLE
  DAIRY_EGG
  STARCH
  FRUIT
  NUTS_SEEDS
  LEGUME
  CONDIMENT
  OTHER
}

// What kind of thing a recipe is. Subsumes the earlier MAIN|SNACK "kind" idea.
enum MealType {
  MAIN
  SNACK
  BREAKFAST
}

// A user of the app. Will later be linked to Supabase Auth (id = auth.users.id).
model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  // First name — set in the profile screen, injected into the chef prompt (greeting).
  firstName      String?
  // Body weight in kg — optional helper; the daily protein target is set directly below.
  weightKg       Float?
  // Optional explicit daily protein target (g). Overrides the value computed from weight.
  proteinTargetG Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  savedRecipes   UserRecipe[]
  recipes        Recipe[]
  preferences    Preference[]
  batches        Batch[]
}

// A recipe. `userId` = ownership: NULL means a shared starter/template recipe (the
// curated library, visible to everyone read-only); non-null means a user's own recipe.
// A recipe is ONE part (MVP): to eat more, place it several times in a batch. Protein/
// part is DERIVED from the ingredients (see lib/recipes.ts) and cached in
// proteinPerServingG so the batch composer's hot path keeps reading a single column.
model Recipe {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String?  @db.Uuid
  title    String
  summary  String?
  // Ordered preparation steps.
  steps    String[]
  mealType MealType @default(MAIN)
  imageUrl String?
  // Cached, derived from the recipe's ingredients (protein for one part), in grams.
  proteinPerServingG     Int?
  caloriesPerServingKcal Int?
  // Legacy: `servings` unused in the MVP (a recipe is one part); `category` unused
  // (superseded by mealType). Kept to stay additive; removable later.
  servings Int      @default(1)
  category String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  savedBy      UserRecipe[]
  batchEntries BatchEntry[]

  @@index([userId])
}

// A shared, GLOBAL ingredient reused across recipes and users. `proteinPer100g` is
// ~objective ("à la louche", PRINCIPLES §3). `normalizedName` is the dedup key
// (lowercased, accent-stripped) the chef uses to reuse existing rows before creating
// new ones. `defaultQuantityG` = the "usual amount" prefill hint.
model Ingredient {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  normalizedName   String             @unique
  category         IngredientCategory
  proteinPer100g   Float
  defaultQuantityG Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  recipeLinks RecipeIngredient[]
}

// Join: an ingredient used in a recipe, with the quantity (g) FOR ONE PART of the recipe.
model RecipeIngredient {
  id           String   @id @default(uuid()) @db.Uuid
  recipeId     String   @db.Uuid
  ingredientId String   @db.Uuid
  quantityG    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

// A user's saved recipe (their "recipe book" entry): links a user to a recipe, with
// an optional 0-3 star rating and a favorite flag. Classic join model. See spec §3.
model UserRecipe {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  recipeId  String   @db.Uuid
  rating    Int?     // 0-3 stars
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

// A preference the chef bot captured about a user (spec §5). Free-form taxonomy:
// type = goût / aversion / contrainte / garde-manger / occasion / objectif ...
// The bot proposes these via tool calling; the server validates + writes them.
model Preference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  value     String
  sentiment String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A planning period the user composes ("Ma semaine"): N days of meals. Belongs to a
// user. The daily protein gauge and the batch quota are COMPUTED from entries, not
// stored (spec §3). See ROADMAP for the later ingredient layer + multi-eater support.
model Batch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String?
  dayCount  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries BatchEntry[]

  @@index([userId])
}

// A dish placed in a plan, on a given day (0-based dayIndex) with a number of servings.
// Protein contribution = servings × recipe.proteinPerServingG. Batch quota = total
// servings of a recipe across the whole plan.
model BatchEntry {
  id        String   @id @default(uuid()) @db.Uuid
  batchId   String   @db.Uuid
  recipeId  String   @db.Uuid
  dayIndex  Int
  servings  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch  Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // No uniqueness on (batch, day, recipe): a user may place the same dish more than once
  // in a day. Quantity is expressed either by `servings` or by multiple entries.
  @@index([batchId])
}
