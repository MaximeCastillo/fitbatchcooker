# Copy to .env and fill with your own Supabase values. Never commit .env.
# Both come from Supabase → project → "Connect" → ORMs / Prisma.

# Pooled connection (Transaction pooler, :6543) — app runtime queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session connection (:5432) — Prisma CLI migrations only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"
